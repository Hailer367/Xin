TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Telegram chat ID to receive the visitor notifications.
# Get it by messaging @userinfobot on Telegram, or use a group/channel ID.
TELEGRAM_CHAT_ID=123456789